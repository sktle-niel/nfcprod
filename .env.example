# Copy to .env.local and fill in. Never commit real values.
# Only VITE_ values reach the browser bundle, so nothing secret goes here.

# Display name of the platform. Leave empty for the brand name, NFC Menu
VITE_APP_NAME=

# Supabase project URL and public anon key (added when the backend is connected)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Order form endpoint (https). Leave empty to run the form in demo mode
VITE_ORDERS_ENDPOINT=

# Province, city and barangay lists for the order form (https). Leave empty to use the public PSGC API.
# Whatever origin is used must also be allowed in the CSP connect-src.
VITE_LOCATIONS_API=

# Map tiles for the delivery pin: a plain https URL template with {z}, {x} and {y} once each and no other braces
# (no {s}, no {r}: write the host and any @2x out). Anything else is ignored, with a console warning, and the public
# OpenStreetMap tiles are used. Leave empty to use them: they have no SLA and a light-use policy.
# Allow the origin in the CSP img-src. If you change provider, change the attribution and the privacy sentence too.
VITE_MAP_TILES=

# Address lookup and place search for the delivery pin (https only). Anything else is ignored, with a console warning,
# and the public Nominatim service is used. Leave empty to use it: it has no SLA and a light-use policy.
# Allow the origin in the CSP connect-src.
VITE_GEOCODER_API=
