# Copy to .env.local and fill in. Never commit real values.
# Only VITE_ values reach the browser bundle, so nothing secret goes here.

# Display name of the platform (brand not decided yet)
VITE_APP_NAME=

# Supabase project URL and public anon key (added when the backend is connected)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
