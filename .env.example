# Copy to .env.local and fill in. Never commit real values.
# Only VITE_ values reach the browser bundle, so nothing secret goes here.

# Display name of the platform. Leave empty for the brand name, NFC Menu
VITE_APP_NAME=

# Supabase project URL and public anon key (added when the backend is connected)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Order form endpoint (https). Leave empty to run the form in demo mode
VITE_ORDERS_ENDPOINT=

# Province, city and barangay lists for the order form (https). Leave empty to use the public PSGC API.
# Whatever origin is used must also be allowed in the CSP connect-src.
VITE_LOCATIONS_API=

# Map style for the delivery pin: the https URL of a MapLibre style JSON. A plain address only: no spaces, no braces,
# no user name or password. A query string with a provider's browser key is fine (that key is public by design, so
# limit it to our domain at the provider). A value that does not fit is ignored, with a console warning, and the public
# OpenFreeMap Positron (light) style is used. Leave empty to use it: it is free, needs no key, and has no SLA.
# Allow its origin (and any origin the style names) in the CSP connect-src. If you change provider, change MAP_CREDITS
# (src/config/map.ts) and the privacy sentence (src/config/copy.ts) too.
VITE_MAP_STYLE=

# Address lookup and place search for the delivery pin (https only). Anything else is ignored, with a console warning,
# and the public Nominatim service is used. Leave empty to use it: it has no SLA and a light-use policy.
# Allow the origin in the CSP connect-src.
VITE_GEOCODER_API=
